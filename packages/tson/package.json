{
  "name": "@ltr8/tson",
  "version": "0.33.0",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "description": "TSON (Typed Schema Object Notation) \u2014 streaming parser, schema compiler and validator. Zero runtime dependencies.",
  "keywords": [
    "tson",
    "parser",
    "schema",
    "serialization",
    "data-format",
    "streaming",
    "typed"
  ],
  "homepage": "https://github.com/litterat/ltr8-io-tson-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litterat/ltr8-io-tson-typescript.git",
    "directory": "packages/tson"
  },
  "bugs": {
    "url": "https://github.com/litterat/ltr8-io-tson-typescript/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@ltr8/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./bind": {
      "@ltr8/source": "./src/bind/index.ts",
      "import": {
        "types": "./dist/bind.d.ts",
        "default": "./dist/bind.js"
      },
      "require": {
        "types": "./dist/bind.d.cts",
        "default": "./dist/bind.cjs"
      }
    },
    "./tree": {
      "@ltr8/source": "./src/tree/index.ts",
      "import": {
        "types": "./dist/tree.d.ts",
        "default": "./dist/tree.js"
      },
      "require": {
        "types": "./dist/tree.d.cts",
        "default": "./dist/tree.cjs"
      }
    },
    "./regex": {
      "@ltr8/source": "./src/regex/index.ts",
      "import": {
        "types": "./dist/regex.d.ts",
        "default": "./dist/regex.js"
      },
      "require": {
        "types": "./dist/regex.d.cts",
        "default": "./dist/regex.cjs"
      }
    },
    "./schema": {
      "@ltr8/source": "./src/schema/index.ts",
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "require": {
        "types": "./dist/schema.d.cts",
        "default": "./dist/schema.cjs"
      }
    },
    "./identity": {
      "@ltr8/source": "./src/identity/index.ts",
      "import": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      },
      "require": {
        "types": "./dist/identity.d.cts",
        "default": "./dist/identity.cjs"
      }
    },
    "./stdlib": {
      "@ltr8/source": "./src/stdlib/index.ts",
      "import": {
        "types": "./dist/stdlib.d.ts",
        "default": "./dist/stdlib.js"
      },
      "require": {
        "types": "./dist/stdlib.d.cts",
        "default": "./dist/stdlib.cjs"
      }
    },
    "./write": {
      "@ltr8/source": "./src/write/index.ts",
      "import": {
        "types": "./dist/write.d.ts",
        "default": "./dist/write.js"
      },
      "require": {
        "types": "./dist/write.d.cts",
        "default": "./dist/write.cjs"
      }
    },
    "./source": {
      "@ltr8/source": "./src/source/index.ts",
      "node": {
        "import": {
          "types": "./dist/source.d.ts",
          "default": "./dist/source.js"
        },
        "require": {
          "types": "./dist/source.d.cts",
          "default": "./dist/source.cjs"
        }
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist dist-types *.tsbuildinfo"
  }
}
