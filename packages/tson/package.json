{
  "name": "@ltr8/tson",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bind": {
      "types": "./dist/bind.d.ts",
      "import": "./dist/bind.js",
      "require": "./dist/bind.cjs"
    },
    "./tree": {
      "types": "./dist/tree.d.ts",
      "import": "./dist/tree.js",
      "require": "./dist/tree.cjs"
    },
    "./regex": {
      "types": "./dist/regex.d.ts",
      "import": "./dist/regex.js",
      "require": "./dist/regex.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist dist-types *.tsbuildinfo"
  }
}
