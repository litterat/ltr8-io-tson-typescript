{
  "private": true,
  "name": "ltr8-io-tson-typescript",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --build --force && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p packages/tson/test/tsconfig.json && tsc --noEmit -p packages/cli/test/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:conformance": "vitest run --project conformance",
    "test:watch": "vitest",
    "build": "npm run build --workspace @ltr8/tson && npm run build --workspace @ltr8/tson-cli",
    "gen:unicode": "node scripts/gen-unicode-tables.mjs",
    "check:unicode": "node scripts/check-unicode-tables.mjs",
    "gen:cli-schemas": "node scripts/gen-cli-bundled-schemas.mjs",
    "refs": "./scripts/fetch-references.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "eslint-import-resolver-node": "0.3.9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
